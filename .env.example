# Copy to .env on the server. Never put the key in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Production: npm run build && npm start (serves both API and dist on port 8787).
PORT=8787
COURT_DATA_FILE=.cat-court/rooms.json

# Only needed if frontend and API are hosted on different domains.
# Set at frontend build time; use your public HTTPS API origin.
VITE_COURT_API_URL=
# Server allows only the exact frontend origins you list here, separated by commas.
COURT_ALLOWED_ORIGINS=

# Pet cloud saves: server-only GitHub credential, never a VITE_ secret.
GITHUB_TOKEN=
GITHUB_REPOSITORY=stevencheninfilm/cat-nest-data
GITHUB_BRANCH=main
CORS_ORIGIN=
VITE_API_URL=
